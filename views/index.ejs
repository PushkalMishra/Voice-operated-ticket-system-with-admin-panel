<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Generated Voice Detector</title>
    <link rel="stylesheet" href="/stylesheet/main.css">
    <link rel="stylesheet" href="/stylesheet/indexx.css">
    <script src="/javascript/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/annyang@2.6.1/dist/annyang.min.js"></script>
    <script src="/javascript/annyang.js"></script>
</head>
<body class="d-flex flex-column vh-100 text-center text-white bg-dark">
    <div class="cover-container d-flex w-100 h-100 py-3 mx-auto flex-column">
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
              <a class="navbar-brand font-weight-bold text-white" href="#">RailINDIA</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse justify-content-end" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                  <a class="nav-link font-weight-bold text-white" href="/">Home</a>
                  <a class="nav-link font-weight-bold text-white" href="/admin/new">ADD Train</a>
                  <a class="nav-link font-weight-bold text-white" href="/bookings/history">Booking</a>
                  <a class="nav-link font-weight-bold text-white" href="/login">Login/Register</a>
                  <a class="nav-link font-weight-bold text-white" href="/logout">Logout</a>
                </div>
              </div>  
            </div>
        </nav>
        <div class="container mt-5">
          <div class="row d-flex align-items-center justify-content-between">
            <div class="col-md-5">
              <div class="card shadow">
                <div class="card-body">
                  <h5 class="card-title">Search Trains</h5>
                  <form id="searchform" action="/trains/search" method="POST">
                    <div class="mb-3">
                      <label for="from" class="form-label">From Station</label>
                      <input type="text" class="form-control" id="from" name="from" placeholder="Enter from station">
                    </div>
                    <div class="mb-3">
                      <label for="to" class="form-label">To Station</label>
                      <input type="text" class="form-control" id="to" name="to"   placeholder="Enter to station">
                    </div>
                    <!-- <button type="submit" class="btn btn-primary w-100">Search by Route</button> -->
        
                  <hr>
                  <!-- <form id="searchform" action="/trains/search" method="POST"> -->
                    <div class="mb-3">
                      <label for="trainNumber" class="form-label">Train Number</label>
                      <input type="number" class="form-control" id="trainNumber" name="trainNumber" placeholder="Enter train number">
                    </div>
                    <button type="submit" class="btn btn-secondary w-100">Search</button>
                  <!-- </form> -->
                </form>
                </div>
              </div>
            </div>
            <div class="col-md-7">
              <main class="px-3 mt-5">
                <h1>RailINDIA</h1>
                <p class="lead">Welcome to Indian Railway! <br> Jump right in and explore our many places.<br>Feel free to share some of your own and comment on others!</p>
                <a href="/trains" class="btn btn-lg btn-secondary font-weight-bold border-white bg-white">View Trains</a>
            </main>
            </div>
          </div>
        </div>
    </div>
</body>
</html>