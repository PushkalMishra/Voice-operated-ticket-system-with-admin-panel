<% layout('layouts/boilerplate') %>
<!-- <link rel="stylesheet" href="/stylesheet/admin.css"> -->
<div class="container mt-4">
  <h1 class="text-center mb-4">All Trains</h1>
  <div class="row">
    <% trains.forEach(train => { %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <div class="card-header">
            <%= train.name %> (Train No: <%= train.trainNumber %>)
          </div>
          <div class="card-body">
            <h5 class="card-title">
                Route: <%= train.route[0].station %> to <%= train.route[train.route.length - 1].station %>
            </h5>
            <p class="card-text">
              <strong>Available Seats:</strong>
              <div class="seat-box">
                <span class="badge bg-primary">Sleeper: <%= train.availableSeats.sleeper %></span>
                <span class="badge bg-success">AC: <%= train.availableSeats.ac %></span>
                <span class="badge bg-warning">General: <%= train.availableSeats.general %></span>
              </div>
            </p>
            <% if (!isAdmin) { %>
              <form action="/bookings/<%= train._id %>/book" method="POST" class="mt-3">
                <div class="mb-3">
                  <label for="seatClass" class="form-label">Select Seat Class</label>
                  <select class="form-select" id="seatClass" name="seatClass" required>
                    <option value="sleeper">Sleeper</option>
                    <option value="ac">AC</option>
                    <option value="general">General</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="date" class="form-label">Select Date</label>
                  <input type="date" class="form-control" id="date" name="date" required>
                </div>
                <button type="submit" class="btn btn-success w-100">Book Now</button>
              </form>
            <% } %>
            <% if (isAdmin) { %>
            <div class="d-flex justify-content-between">
              <a href="/admin/<%= train._id %>/edit" class="btn btn-primary">Edit</a>
              <!-- Delete Button -->
              <form action="/admin/<%= train._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this train?');">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
            <%}%>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>