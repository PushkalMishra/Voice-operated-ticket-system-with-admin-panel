<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheet/admin.css">
<div class="container">
  <h1 class="text-center mb-4">Add New Train</h1>
  <div class="custom-form">
    <div class="form">
      <form action="/admin/new" method="POST">
        <!-- Train Number -->
        <div class="mb-3">
            <label for="trainNumber" class="form-label">Train Number</label>
            <input type="number" class="form-control" id="trainNumber" name="trainNumber" required>
        </div>
  
        <!-- Train Name -->
        <div class="mb-3">
            <label for="name" class="form-label">Train Name</label>
            <input type="text" class="form-control" id="name" name="name" required>
        </div>
  
        <!-- Route -->
        <div class="mb-3">
            <label for="route" class="form-label">Route (JSON format)</label>
            <textarea class="form-control" id="route" name="route" rows="3" required></textarea>
            <small class="form-text text-muted">
                Example: <code>{"station": ["Station A", "Station B", "Station C"]}</code>
            </small>
        </div>
  
        <!-- Available Seats -->
        <div class="row mb-3">
            <div class="col">
                <label for="sleeper" class="form-label">Sleeper Seats</label>
                <input type="number" class="form-control" id="sleeper" name="sleeper" required>
            </div>
            <div class="col">
                <label for="ac" class="form-label">AC Seats</label>
                <input type="number" class="form-control" id="ac" name="ac" required>
            </div>
            <div class="col">
                <label for="general" class="form-label">General Seats</label>
                <input type="number" class="form-control" id="general" name="general" required>
            </div>
        </div>
  
        <!-- Fare -->
        <div class="row mb-3">
            <div class="col">
                <label for="sleeperFare" class="form-label">Sleeper Fare</label>
                <input type="number" class="form-control" id="sleeperFare" name="sleeperFare" required>
            </div>
            <div class="col">
                <label for="acFare" class="form-label">AC Fare</label>
                <input type="number" class="form-control" id="acFare" name="acFare" required>
            </div>
            <div class="col">
                <label for="generalFare" class="form-label">General Fare</label>
                <input type="number" class="form-control" id="generalFare" name="generalFare" required>
            </div>
        </div>
  
        <!-- <div class="mb-3">
          <label for="status" class="form-label">Status</label>
          <input type="text" class="form-control" id="status" name="status" required>
        </div> -->
  
        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary">Add Train</button>
    </form>
    </div>
  </div>
</div>